{
  "name": "jx3-loot-forge",
  "version": "1.6.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/sync-public-data.mjs && vite",
    "build": "node scripts/sync-public-data.mjs && vite build",
    "build:web": "node scripts/sync-public-data.mjs && vite build",
    "build:offline": "node scripts/build-offline.mjs",
    "start": "vite preview",
    "sync:data": "node scripts/sync-public-data.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "crawl:catalog": "node scripts/crawl-catalog.mjs --client=std",
    "crawl:catalog:std": "node scripts/crawl-catalog.mjs --client=std",
    "crawl:catalog:origin": "node scripts/crawl-catalog.mjs --client=origin",
    "reclassify:catalog": "node scripts/reclassify-catalog.mjs",
    "package:artifacts": "node scripts/package-artifacts.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:web && npm run build:offline"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.8",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
