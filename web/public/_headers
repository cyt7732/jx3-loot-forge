# HTML pages: always revalidate to ensure immediate updates after deployment
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed Vite assets: immutable cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Catalog datasets: cache for 1 day, allow stale while revalidating
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Static brand assets and icons
/favicon.svg
  Cache-Control: public, max-age=604800
/logo.jpg
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
