{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "剑网3掉落工坊",
  "version": "1.0.5",
  "identifier": "com.lootforge.jx3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "剑网3掉落工坊",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
